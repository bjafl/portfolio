---
import { contactValue, site } from '../config/site';
import type { Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const email = contactValue(site.email);
const linkedin = contactValue(site.linkedin);
const btn = 'inline-flex h-9 items-center gap-2 rounded-md px-4 font-medium no-underline hover:no-underline';
---
<footer class="border-t border-border">
  <div class="mx-auto max-w-[1120px] px-4 py-12 md:px-6">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-lg border border-border bg-card p-6 md:p-8">
      <div class="min-w-0 flex-[1_1_22rem]">
        <h2 class="text-2xl">{t(locale, 'footer.contact')}</h2>
        <p class="mt-2 max-w-[52ch] text-muted-foreground">{t(locale, 'footer.text')}</p>
      </div>
      <ul class="flex flex-wrap gap-2">
        {email && <li><a href={`mailto:${email}`} class={`${btn} bg-primary text-primary-foreground hover:bg-primary-hover`}><Icon name="mail" />{t(locale, 'footer.email')}</a></li>}
        <li><a href={site.github} rel="me" class={`${btn} bg-secondary text-secondary-foreground hover:bg-accent`}><Icon name="github" />{t(locale, 'footer.github')}</a></li>
        {linkedin && <li><a href={linkedin} rel="me" class={`${btn} bg-secondary text-secondary-foreground hover:bg-accent`}><Icon name="linkedin" />{t(locale, 'footer.linkedin')}</a></li>}
      </ul>
    </div>
    <p class="mt-6 text-xs text-muted-foreground">&copy; {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>
