---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getProjects, slugOf, type ProjectEntry } from '../lib/projects';
import CaseMeta from './CaseMeta.astro';
import ProjectCard from './ProjectCard.astro';
interface Props { project: ProjectEntry; locale: Locale }
const { project, locale } = Astro.props;
const { title, summary, cover, coverAlt, related } = project.data;
const { Content } = await render(project);
const published = await getProjects(locale);
const relatedProjects = (related ?? [])
  .filter((slug) => slug !== slugOf(project.id))
  .map((slug) => published.find((p) => slugOf(p.id) === slug))
  .filter((p): p is ProjectEntry => !!p);
---
<BaseLayout locale={locale} title={title} description={summary} ogType="article">
  <article class="mx-auto max-w-3xl">
    <h1 class="mb-6 text-4xl font-bold">{title}</h1>
    <CaseMeta project={project} locale={locale} />
    {cover && coverAlt && (
      <Image src={cover as ImageMetadata} alt={coverAlt} class="mb-8 w-full rounded-[var(--radius-card)]" widths={[480, 800, 1200]} sizes="(min-width: 768px) 768px, 100vw" />
    )}
    <div class="prose-case"><Content /></div>
  </article>
  {relatedProjects.length > 0 && (
    <section aria-labelledby="related-heading" class="mx-auto mt-12 max-w-3xl">
      <h2 id="related-heading" class="mb-4 text-2xl font-bold">{t(locale, 'case.related')}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {relatedProjects.map((p) => <ProjectCard project={p} locale={locale} />)}
      </div>
    </section>
  )}
  <p class="mx-auto mt-12 max-w-3xl"><a href={localizePath('projects', locale)}>&larr; {t(locale, 'case.back')}</a></p>
</BaseLayout>
