---
import { localizePath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { formatYearRange } from '../lib/project-model';
import { slugOf, type ProjectEntry } from '../lib/projects';
import StatusBadge from './StatusBadge.astro';
interface Props { project: ProjectEntry; locale: Locale }
const { project, locale } = Astro.props;
const { title, summary, status, period, stack, service, technical } = project.data;
const href = localizePath('project', locale, slugOf(project.id));
---
<article class="overflow-hidden rounded-lg border border-border bg-card text-card-foreground">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 p-6 pb-5">
    <div class="min-w-0">
      <h3 class="text-[22px]"><a href={href} class="text-foreground">{title}</a></h3>
      <p class="mt-1.5 max-w-[64ch] text-muted-foreground">{summary}</p>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <span class="font-mono tabular text-muted-foreground">{formatYearRange(period)}</span>
      <StatusBadge status={status} locale={locale} />
    </div>
  </div>
  {(service || technical) && (
    <div class="grid border-t border-border md:grid-cols-2">
      {service && (
        <div class="bg-accent px-6 pt-5 pb-6">
          <p class="font-mono text-xs text-accent-foreground">{t(locale, 'layer.service')}</p>
          <ul class="mt-2.5 flex list-disc flex-col gap-1.5 pl-4.5 text-foreground">
            {service.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      )}
      {technical && (
        <div class="px-6 pt-5 pb-6">
          <p class="font-mono text-xs text-muted-foreground">{t(locale, 'layer.technical')}</p>
          <ul class="mt-2.5 flex list-disc flex-col gap-1.5 pl-4.5">
            {technical.map((s) => <li>{s}</li>)}
          </ul>
          {stack.length > 0 && <p class="mt-3.5 font-mono text-xs text-muted-foreground">{stack.slice(0, 5).join(' · ')}</p>}
        </div>
      )}
    </div>
  )}
</article>
