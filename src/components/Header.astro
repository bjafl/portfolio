---
import { site } from '../config/site';
import { localizePath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: localizePath('projects', locale), label: t(locale, 'nav.projects') },
  { href: localizePath('about', locale), label: t(locale, 'nav.about') },
];
const linkClass =
  'inline-flex h-9 items-center rounded-md px-3 font-medium text-foreground no-underline hover:bg-accent hover:text-accent-foreground hover:no-underline aria-[current=page]:bg-accent aria-[current=page]:text-accent-foreground';
---
<header class="border-b border-border bg-background">
  <div class="mx-auto flex min-h-16 max-w-[1120px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 md:px-6">
    <a href={localizePath('home', locale)} class="text-[15px] font-semibold tracking-[-0.01em] text-foreground no-underline hover:no-underline">{site.name}</a>
    <div class="flex flex-wrap items-center gap-1">
      <nav aria-label={t(locale, 'nav.label')}>
        <ul class="flex gap-1">
          {links.map((l) => (
            <li><a href={l.href} class={linkClass} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <span aria-hidden="true" class="mx-2 hidden h-5 w-px bg-border sm:block"></span>
      <LangSwitch locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
