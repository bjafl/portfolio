---
import type { CollectionEntry } from 'astro:content';
import { localizePath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getProjects, hasProject, slugOf } from '../lib/projects';
interface Props { locale: Locale; offer: CollectionEntry<'home'>['data']['offer'] }
const { locale, offer } = Astro.props;
const titles = new Map((await getProjects(locale)).map((p) => [slugOf(p.id), p.data.title]));
const groups = [
  { key: 'technical', label: t(locale, 'offer.technical'), items: offer.technical, box: 'bg-card', tag: 'text-muted-foreground' },
  { key: 'human', label: t(locale, 'offer.human'), items: offer.human, box: 'bg-accent', tag: 'text-accent-foreground' },
] as const;
---
<section aria-labelledby="offer-heading" class="pt-20">
  <h2 id="offer-heading" class="text-2xl">{t(locale, 'section.offer')}</h2>
  <p class="mt-2 max-w-[62ch] text-muted-foreground">{t(locale, 'offer.intro')}</p>
  <div class="mt-6 grid gap-4 md:grid-cols-2">
    {groups.map((g) => (
      <div class={`rounded-lg border border-border px-6 pt-2 pb-1 ${g.box}`}>
        <h3 class={`mt-4 mb-1 font-mono text-xs font-normal tracking-normal ${g.tag}`}>{g.label}</h3>
        <ul>
          {g.items.map((item) => {
            const projects = (item.projects ?? []).filter((s) => hasProject(s, locale));
            const refs = projects.length > 0 || item.about || item.note;
            return (
              <li class="border-b border-border py-4 last:border-b-0">
                <p class="text-base font-semibold">{item.title}</p>
                <p class="mt-1">{item.text}</p>
                {refs && (
                  <p class="mt-2 flex flex-wrap gap-x-3 text-[13px]">
                    {projects.map((s) => <a href={localizePath('project', locale, s)}>{titles.get(s)}</a>)}
                    {item.about && <a href={localizePath('about', locale)}>{t(locale, 'nav.about')}</a>}
                    {item.note && <span>{item.note}</span>}
                  </p>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</section>
