---
import { alternatePath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { hasProject } from '../lib/projects';
import Icon from './Icon.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const target: Locale = locale === 'nb' ? 'en' : 'nb';
const href = alternatePath(Astro.url.pathname, target, hasProject);
---
<a
  href={href}
  hreflang={target}
  lang={target}
  aria-label={`${t(locale, 'lang.switch')}: ${t(locale, 'lang.other')}`}
  class="inline-flex h-11 items-center gap-2 rounded-md px-3 font-medium text-muted-foreground no-underline hover:bg-accent hover:text-accent-foreground hover:no-underline"
><Icon name="globe" /><span class="max-sm:sr-only">{t(locale, 'lang.other')}</span></a>
