---
import { alternatePath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { hasProject } from '../lib/projects';
interface Props { locale: Locale }
const { locale } = Astro.props;
const target: Locale = locale === 'nb' ? 'en' : 'nb';
const href = alternatePath(Astro.url.pathname, target, hasProject);
---
<a
  href={href}
  hreflang={target}
  lang={target}
  aria-label={`${t(locale, 'lang.switch')}: ${t(locale, 'lang.other')}`}
  class="inline-flex h-11 items-center rounded-full border border-border bg-surface px-4 text-sm font-semibold text-text no-underline"
>{t(locale, 'lang.other')}</a>
