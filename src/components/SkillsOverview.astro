---
import { localizePath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { AREAS, areaLabel } from '../lib/areas';
import { getProjects } from '../lib/projects';
interface Props { locale: Locale }
const { locale } = Astro.props;
const projects = await getProjects(locale);
const fills = ['bg-peach', 'bg-sage', 'bg-blue'];
---
<section aria-labelledby="skills-heading" class="mt-14">
  <h2 id="skills-heading" class="text-2xl font-bold">{t(locale, 'section.skills')}</h2>
  <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {AREAS.map((a, i) => {
      const n = projects.filter((p) => p.data.areas.includes(a)).length;
      return (
        <li>
          <a href={`${localizePath('projects', locale)}?area=${a}`} class={`flex items-center justify-between gap-3 rounded-[var(--radius-card)] px-5 py-4 font-semibold text-ink no-underline ${fills[i % 3]}`}>
            <span>{areaLabel(a, locale)}</span>
            <span class="text-sm">{n} {t(locale, n === 1 ? 'skills.count.one' : 'skills.count.other')}</span>
          </a>
        </li>
      );
    })}
  </ul>
</section>
