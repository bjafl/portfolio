---
import { getEntry } from 'astro:content';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import Hero from '../components/Hero.astro';
import Offer from '../components/Offer.astro';
import Principles from '../components/Principles.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const locale = 'nb';
const home = (await getEntry('home', locale))!.data;
---
<BaseLayout locale={locale} title={home.hero.title} description={home.hero.description}>
  <Hero locale={locale} home={home} />
  <Principles locale={locale} principles={home.principles} />
  <FeaturedProjects locale={locale} />
  <Timeline locale={locale} />
  <Offer locale={locale} offer={home.offer} />
</BaseLayout>
