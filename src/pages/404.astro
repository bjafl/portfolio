---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath } from '../i18n/routes';
import { t } from '../i18n/ui';
---
<BaseLayout locale="nb" title={t('nb', 'notfound.title')} noindex>
  <h1 class="text-3xl font-bold">{t('nb', 'notfound.title')}</h1>
  <p class="mt-3">{t('nb', 'notfound.text')}</p>
  <p class="mt-6"><a href={localizePath('home', 'nb')}>{t('nb', 'nav.home')}</a></p>
</BaseLayout>
