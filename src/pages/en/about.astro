---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const locale = 'en';
const entry = (await getEntry('pages', 'en/about'))!;
const { Content } = await render(entry);
---
<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-3xl">
    <h1 class="mb-6 text-4xl font-bold">{entry.data.title}</h1>
    <div class="prose-case"><Content /></div>
  </article>
</BaseLayout>
