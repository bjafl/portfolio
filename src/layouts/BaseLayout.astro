---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../config/site';
import { alternatePath, LOCALES, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { hasProject } from '../lib/projects';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}
const { locale, title, description, ogImage, noindex = false, ogType = 'website' } = Astro.props;
const pathname = Astro.url.pathname;
const origin = Astro.site ?? new URL(Astro.url.origin);
const abs = (p: string) => new URL(p, origin).href;
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;
const alternates = LOCALES.map((l) => ({ l, href: abs(alternatePath(pathname, l, hasProject)) }));
const OG_LOCALE: Record<Locale, string> = { nb: 'nb_NO', en: 'en_GB' };
const xDefault = alternates.find((a) => a.l === 'nb')!.href;
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    {!noindex && <meta property="og:url" content={abs(pathname)} />}
    <meta name="twitter:card" content="summary" />
    {ogImage && <meta property="og:image" content={abs(ogImage)} />}
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={abs(pathname)} />
        {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
        <link rel="alternate" hreflang="x-default" href={xDefault} />
      </>
    )}
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground">{t(locale, 'skip.link')}</a>
    <Header locale={locale} />
    <main id="main" class="mx-auto w-full max-w-[1120px] flex-1 px-4 pb-24 md:px-6">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
